# syntax=docker/dockerfile:1.7
ARG NODE_VERSION=20

# ─── base ────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# ─── prune ───────────────────────────────────────────────────────────────────
FROM base AS pruner
RUN pnpm add -g turbo@2.5.4
WORKDIR /app
COPY . .
RUN turbo prune @repo/api --docker

# ─── install all deps + build ─────────────────────────────────────────────────
FROM base AS builder
WORKDIR /app
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY --from=pruner /app/out/full/ .
RUN pnpm --filter @repo/database generate
RUN pnpm --filter @repo/shared build
RUN pnpm --filter @repo/database build
RUN pnpm --filter @repo/api build

# ─── production deps only ────────────────────────────────────────────────────
FROM base AS prod-deps
WORKDIR /app
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/packages/database/generated ./packages/database/generated
RUN pnpm install --frozen-lockfile --ignore-scripts --prod --no-optional
RUN pnpm store prune

# ─── runtime ─────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS runner
ENV NODE_ENV=production
RUN apk add --no-cache libc6-compat \
    && addgroup -S appgroup && adduser -S app -G appgroup
WORKDIR /app

# prod node_modules (no devDeps, no typescript, no vitest, etc.)
COPY --from=prod-deps --chown=app:appgroup /app/node_modules ./node_modules
COPY --from=prod-deps --chown=app:appgroup /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=prod-deps --chown=app:appgroup /app/packages/database/node_modules ./packages/database/node_modules
COPY --from=prod-deps --chown=app:appgroup /app/packages/shared/node_modules ./packages/shared/node_modules

# compiled output only — no src, no tsconfig
COPY --from=builder --chown=app:appgroup /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=app:appgroup /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=app:appgroup /app/apps/api/openapi ./apps/api/openapi
COPY --from=builder --chown=app:appgroup /app/packages/database/dist ./packages/database/dist
COPY --from=builder --chown=app:appgroup /app/packages/database/generated ./packages/database/generated
COPY --from=builder --chown=app:appgroup /app/packages/database/prisma ./packages/database/prisma
COPY --from=builder --chown=app:appgroup /app/packages/database/package.json ./packages/database/package.json
COPY --from=builder --chown=app:appgroup /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder --chown=app:appgroup /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder --chown=app:appgroup /app/package.json ./package.json

RUN mkdir -p /app/apps/api/uploads && chown app:appgroup /app/apps/api/uploads

USER app
EXPOSE 4100
CMD ["node", "apps/api/dist/index.js"]
